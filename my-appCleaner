VERBS: Final = ("show", "rm", "intel", "leftovers", "help")
ADMIN: Final = ("--run-tests", "--version", "--create-config")


@dataclass
class Cli:
    verb: Optional[str] = None
    args: List[str] = field(default_factory=lambda: [])
    quiet: Optional[bool] = None
    vrb: Optional[bool] = None
    dbg: Optional[bool] = None
    dbg_file: Optional[str] = None
    config: Optional[str] = None


def parse_cli(argv: Sequence[str]) -> Cli:
    """The options anywhere; the first other word is the verb, or an <APP> for show."""
    c = Cli()
    args = list(argv)
    i = 0
    while i < len(args):
        a = args[i]
        key, eq, val = a.partition("=")
        i += 1
        if a in ("-Q", "--quiet"):
            c.quiet = True
        elif a in ("-V", "--verbose"):
            c.vrb = True
        elif key in ("-D", "--debug"):
            c.dbg = True
            if eq:
                c.dbg_file = val
            elif i < len(args) and args[i].endswith(".log") and not args[i].startswith("-"):
                c.dbg_file = args[i]
                i += 1
        elif key == "--config":
            v = val if eq else (args[i] if i < len(args) else "")
            if not eq:
                i += 1
            if not v:
                err("026", "--config needs a <FILE>", 2)
            c.config = v
        elif a in ("-h", "--help"):
            c.verb = "help"
        elif key in ADMIN and c.verb is None:
            c.verb = key
            if eq:
                c.args.append(val)
            elif key != "--version" and i < len(args) and not args[i].startswith("-"):
                c.args.append(args[i])
                i += 1
        elif a.startswith("-") and a != "-":
            verb = a.lstrip("-")
            hint = f" -- you mean `{SCRIPT_NAME} {verb}`" if verb in VERBS else f" ({SCRIPT_NAME} --help)"
            err("027", f"no such option '{a}'{hint}", 2)
        elif c.verb is None:
            if a in VERBS:
                c.verb = a
            else:
                c.verb = "show"
                c.args.append(a)
        else:
            c.args.append(a)
    if "go" in c.args and c.args[-1] != "go":
        err("028", f"go is the final word -- you mean: {SCRIPT_NAME} {c.verb} "
                   f"{quoted([x for x in c.args if x != 'go'])} go", 2)
    if "go" in c.args and c.verb != "rm":
        err("029", f"{c.verb} only looks, it takes no go -- you mean: {SCRIPT_NAME} rm "
                   f"{quoted(c.args[:-1])} go", 2)
    return c


def create_config(target: Optional[str]) -> int:
    if target is None:
        sys.stdout.write(DEFAULT_CONFIG)
        return 0
    p = Path(target)
    try:
        with p.open("x", encoding="utf-8") as f:
            f.write(DEFAULT_CONFIG)
    except FileExistsError:
        err("030", f"{p} exists -- never written over (compare it with `{SCRIPT_NAME} --create-config`)")
    OUT.msg(f" >>> wrote the default config to {p}")
    return 0


def run(argv: Sequence[str]) -> int:
    c = parse_cli(argv)
    if c.verb == "--run-tests":
        return run_tests(c.args[0] if c.args else "")
    if c.verb == "--version":
        OUT.result(version_line())
        return 0
    if c.verb == "--create-config":
        return create_config(c.args[0] if c.args else None)
    if c.verb in (None, "help"):
        OUT.result(HELP)
        return 0 if c.verb == "help" else 2
    s = load_settings(c.config)
    OUT.dbg_on = c.dbg if c.dbg is not None else s.dbg
    OUT.dbg_file = Path(c.dbg_file) if c.dbg_file else None
    OUT.vrb = OUT.dbg_on or (c.vrb if c.vrb is not None else s.vrb)
    OUT.quiet = (c.quiet if c.quiet is not None else s.quiet) and not OUT.vrb   # -V beats -Q
    install_completion()
    return _verbs[c.verb](s, c.args)


