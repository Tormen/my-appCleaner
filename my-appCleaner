# --- 1. output, errors -----------------------------------------------------

class CleanerError(Exception):
    """The tool's one failure: a code naming the source line, the exit status, what to know."""

    def __init__(self, code: str, text: str, rc: int) -> None:
        super().__init__(f"{code}: {text}")
        self.code = code
        self.text = text
        self.rc = rc


def err(code: str, text: str, rc: int = 1) -> NoReturn:
    raise CleanerError(code, text, rc)


def err_line(code: str, rc: int, text: str) -> str:
    """The one ERROR line, for the failures main() reports without raising."""
    return f"ERROR {code} [{rc}]: {text}"


class Out:
    """stdout carries results (lists, plans); narration goes to stderr, silenced by -Q."""

    def __init__(self) -> None:
        self.quiet = False
        self.vrb = False
        self.dbg_on = False
        self.dbg_file: Optional[Path] = None

    def msg(self, text: str) -> None:
        if not self.quiet:
            print(text, file=sys.stderr, flush=True)

    def det(self, text: str) -> None:
        if self.vrb:
            self.msg(text)

    def dbg(self, text: str) -> None:
        if not self.dbg_on:
            return
        print(" ~~~ " + text, file=sys.stderr, flush=True)
        if self.dbg_file is not None:
            try:
                with self.dbg_file.open("a", encoding="utf-8") as f:
                    f.write(f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {text}\n")
            except OSError:
                pass

    def warn(self, text: str) -> None:
        print("WARNING: " + text, file=sys.stderr, flush=True)

    def error(self, text: str) -> None:
        print(text, file=sys.stderr, flush=True)

    def result(self, line: str) -> None:
        print(line, flush=True)


OUT = Out()
