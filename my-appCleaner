def run_tests(name_filter: str) -> int:
    global _geteuid, _completion_on, _site_conf, _root, _kill
    defined = {n for n in globals() if re.fullmatch(r"t_[a-z0-9_]+", n)}
    listed = {f.__name__ for f in TESTS}
    if defined != listed:
        print(f"Bail out! test functions and TESTS differ: {sorted(defined ^ listed)}")
        return 1
    chosen = [f for f in TESTS if name_filter in f.__name__]
    print(f"1..{len(chosen)}", flush=True)
    bad, home = 0, Path.cwd()
    real = (_geteuid, _site_conf, _root, _kill)
    for k, test in enumerate(chosen, 1):
        with tempfile.TemporaryDirectory(prefix=f"{SCRIPT_NAME}-tests.") as d:
            t = T(Path(d).resolve())
            os.chdir(t.dir)
            _geteuid, _completion_on = os.getuid, False
            _site_conf = t.dir / "site.conf"      # the test's own, not the machine's: none until a test writes it
            _root = t.root
            try:
                test(t)
            except Exception as e:   # a test that crashes fails, and the next one runs
                t.bad.append(f"crashed: {type(e).__name__}: {e}")
                t.bad.extend(traceback.format_exc().splitlines())
            finally:
                _geteuid, _site_conf, _root, _kill = real
                _completion_on = True
                os.chdir(home)
                OUT.__init__()
        print(f"{'not ok' if t.bad else 'ok'} {k} - {test.__name__}", flush=True)
        for b in t.bad:
            print(f"#   {b}")
        bad += bool(t.bad)
    return 1 if bad else 0


