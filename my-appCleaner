"""


_completion_on = True     # off in --run-tests: a test never writes into $HOME


def install_completion() -> None:
    """The zsh completion, written when it changed -- best effort, never fails a run."""
    if not _completion_on:
        return
    try:
        folder = Path.home() / ".zsh" / "completions"
        target = folder / f"_{SCRIPT_NAME}"
        if target.is_file() and target.read_text(encoding="utf-8") == COMPLETION:
            return
        folder.mkdir(parents=True, exist_ok=True)
        tmp = folder / f".{target.name}.{os.getpid()}"
        tmp.write_text(COMPLETION, encoding="utf-8")
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
        for dump in Path.home().glob(".zcompdump*"):
            dump.unlink()
        zshrc = Path.home() / ".zshrc"
        if zshrc.is_file() and ".zsh/completions" not in zshrc.read_text(encoding="utf-8"):
            with zshrc.open("a", encoding="utf-8") as f:
                f.write("\nfpath=(~/.zsh/completions $fpath); autoload -Uz compinit && compinit\n")
        OUT.msg(f" >>> zsh completion written: {target}   (it changed: new verbs or options)")
    except OSError as e:
        OUT.dbg(f"zsh completion not written: {e}")


def trace_file() -> Path:
    """Where a bug's trace goes: the user's log folder (site.conf), else the temp folder."""
    name = f"{SCRIPT_NAME}.{datetime.datetime.now():%Y-%m-%d_%H%M%S}.{os.getpid()}.trace"
    try:
        d = Path(read_site().log_base_dir) / pwd.getpwuid(_geteuid()).pw_name
        if os.access(d, os.W_OK):
            return d / name
    except (CleanerError, OSError, KeyError):
        pass
    return Path(tempfile.gettempdir()) / name


def main(argv: Sequence[str]) -> int:
    """Every way a run ends: 0; 1 or 2 with ONE error line; 130 on Ctrl-C; 70
    and a trace file on a bug -- never a traceback on the screen."""
    try:
        return run(argv)
    except CleanerError as e:
        OUT.error(err_line(e.code, e.rc, e.text))
        return e.rc
    except KeyboardInterrupt:
        OUT.error(f"{SCRIPT_NAME}: interrupted (Ctrl-C) while {_phase} -- what was moved to the Trash before "
                  f"stays there (LOG names it); run it again to go on")
        return 130
    except OSError as e:
        OUT.error(err_line("031", 1, f"while {_phase}: {e.strerror or e}" + (f": {e.filename}" if e.filename else "")))
        return 1
    except Exception as e:   # a bug: one line here, the trace in a file
        where = trace_file()
        try:
            where.write_text(f"{version_line()}\nargv: {list(argv)}\n\n{traceback.format_exc()}", encoding="utf-8")
        except OSError:
            where = Path("(not written)")
        OUT.error(err_line("032", 70, f"unexpected {type(e).__name__} while {_phase} -- the trace: {where}"))
        return 70


