def phase(text: str) -> None:
    """What the run is doing now -- the Ctrl-C line names it."""
    global _phase
    _phase = text
    OUT.dbg(f"phase: {text}")


def count(n: int) -> str:
    """4453 -> '4 453'."""
    return f"{n:,}".replace(",", " ")


def human(size: int) -> str:
    """212000000 -> '212.0 MB'."""
    f = float(size)
    for unit in ("B", "KB", "MB"):
        if f < 1000:
            return f"{f:.0f} B" if unit == "B" else f"{f:.1f} {unit}"
        f /= 1000
    return f"{f:.1f} GB"


