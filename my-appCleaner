def t_unexpected_error(t: T) -> None:
    real = _verbs["leftovers"]

    def boom(s: Settings, args: Sequence[str]) -> int:
        raise ValueError("a bug")

    _verbs["leftovers"] = boom
    try:
        rc, _, e = t.run(["leftovers"])
    finally:
        _verbs["leftovers"] = real
    m = re.search(r"the trace: (\S+)", e)
    t.check(rc == 70 and "Traceback" not in e and m is not None, f"rc {rc}: {e}")
    if m:
        trace = Path(m.group(1))
        t.check(trace.is_file() and "ValueError: a bug" in trace.read_text(encoding="utf-8"), "the trace is in its file")
        trace.unlink(missing_ok=True)


def t_ctrl_c(t: T) -> None:
    t.write("usr/local/bin/x", "MACHO x86_64\n", 0o755)
    t.table["file-sleep"] = True
    t.save()
    env = dict(os.environ, MY_APPCLEANER_TEST_ROOT=str(t.dir))
    p = subprocess.Popen([sys.executable, os.path.realpath(__file__), "--config", str(t.config()), "intel",
                          str(t.path("usr/local"))], stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, text=True)
    deadline = time.time() + 20
    while "file -F" not in t.calls() and time.time() < deadline:
        time.sleep(0.1)
    time.sleep(0.3)
    p.send_signal(signal.SIGINT)
    _, e = p.communicate(timeout=30)
    t.check(p.returncode == 130 and "interrupted (Ctrl-C) while typing" in e and "Traceback" not in e,
            f"rc {p.returncode}: {e}")


