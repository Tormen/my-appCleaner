class T:
    """One test: its system tree, the stub, the config, what it found wrong."""

    def __init__(self, folder: Path) -> None:
        self.dir = folder
        self.root = folder / "sys"
        self.bad: List[str] = []
        self.me = pwd.getpwuid(os.getuid()).pw_name
        self.uid = os.getuid()
        self.home = self.root / "Users" / self.me
        for d in ("Applications", "Library/LaunchDaemons", "Library/LaunchAgents", "Library/Preferences",
                  "Library/Application Support", "Library/PrivilegedHelperTools", "Library/Extensions", "usr/local/bin",
                  f"Users/{self.me}/Library/Preferences", f"Users/{self.me}/Library/Caches",
                  f"Users/{self.me}/Library/Group Containers", f"Users/{self.me}/Library/LaunchAgents",
                  "Users/other/Library/Preferences", "Users/Shared", "var/root"):
            (self.root / d).mkdir(parents=True, exist_ok=True)
        self.bin = folder / "bin"
        self.bin.mkdir()
        stub = self.bin / "stub"
        stub.write_text(f"#!{sys.executable}\n" + STUB.split("\n", 1)[1], encoding="utf-8")
        stub.chmod(0o755)
        for c in ("pkgutil", "launchctl", "codesign", "ps", "sfltool", "brew", "file"):
            (self.bin / c).symlink_to(stub)
        self.table: Dict[str, object] = {"pkgutil": {"--pkgs": ""}}
        self.save()

    def check(self, ok: bool, what: str) -> None:
        if not ok:
            self.bad.append(what)

    def answer(self, cmd: str, args: str, out: str, rc: int = 0) -> None:
        cast(Dict[str, object], self.table.setdefault(cmd, {}))[args] = [out, rc]
        self.save()

    def save(self) -> None:
        (self.bin / "stub.json").write_text(json.dumps(self.table), encoding="utf-8")

    def calls(self) -> str:
        p = self.bin / "calls.log"
        return p.read_text(encoding="utf-8") if p.exists() else ""

    def path(self, rel: str) -> Path:
        return self.root / rel

    def write(self, rel: str, text: str = "x", mode: int = 0o644) -> Path:
        p = self.root / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")
        p.chmod(mode)
        return p

    def app(self, rel: str, bid: str, team: str = "", archs: str = "arm64") -> Path:
        a = self.root / rel
        exe = a / "Contents" / "MacOS" / a.stem
        exe.parent.mkdir(parents=True)
        exe.write_text(f"MACHO {archs}\n", encoding="utf-8")
        exe.chmod(0o755)
        with (a / "Contents" / "Info.plist").open("wb") as f:
            plistlib.dump({"CFBundleIdentifier": bid, "CFBundleExecutable": a.stem}, f)
        if team:
            self.answer("codesign", f"-dv {a}", f"Identifier={bid}\nTeamIdentifier={team}\n")
        return a

    def plist(self, rel: str, data: Dict[str, object]) -> Path:
        p = self.root / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        with p.open("wb") as f:
            plistlib.dump(data, f)
        return p

    def receipt(self, pkg: str, location: str, files: Sequence[str]) -> None:
        t = cast(Dict[str, object], self.table["pkgutil"])
        t["--pkgs"] = str(t["--pkgs"]) + pkg + "\n"
        info = plistlib.dumps({"pkgid": pkg, "volume": "/", "install-location": location}).decode()
        self.answer("pkgutil", f"--pkg-info-plist {pkg}", info)
        self.answer("pkgutil", f"--pkg-info {pkg}", f"package-id: {pkg}\n")
        self.answer("pkgutil", f"--files {pkg}", "".join(f + "\n" for f in files))
        self.answer("pkgutil", f"--forget {pkg}", f"Forgot package '{pkg}' on '/'.\n")

    def config(self, extra: str = "") -> Path:
        p = self.dir / "conf"
        b = self.bin
        p.write_text(f'FILE="{b}/file"\nPKGUTIL="{b}/pkgutil"\nLAUNCHCTL="{b}/launchctl"\nCODESIGN="{b}/codesign"\n'
                     f'PS="{b}/ps"\nSFLTOOL="{b}/sfltool"\nBREW="{b}/brew"\nLOG="{self.dir}/log/moves.log"\n'
                     f'INTEL_ROOTS="/Applications|/Library|/usr/local"\n'
                     f'INTEL_PRUNE="/Library/Caches"\n' + extra, encoding="utf-8")
        return p

    def run(self, argv: Sequence[str]) -> Tuple[int, str, str]:
        """The tool in-process: rc, stdout, stderr."""
        out, errs = io.StringIO(), io.StringIO()
        try:
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(errs):
                rc = main(["--config", str(self.config()), *argv])
        finally:
            OUT.__init__()
        return rc, out.getvalue(), errs.getvalue()

    def trashed(self, name: str, user: str = "") -> bool:
        return (self.root / "Users" / (user or self.me) / ".Trash" / name).exists()


def epson(t: T) -> Path:
    """An app suite: two apps, an agent, prefs for two users, a receipt with a vendor folder, a kext."""
    a = t.app("Applications/Example Software/Event Manager.app", "com.example.Event-Manager", "TEAM123456")
    t.app("Applications/Example Software/Example Manuals.app", "com.example.Manuals", "TEAM123456")
    t.write(f"Users/{t.me}/Library/Preferences/com.example.Event-Manager.plist")
    t.write("Users/other/Library/Preferences/com.example.Event-Manager.plist")
    t.write(f"Users/{t.me}/Library/Caches/com.example.Manuals/cache.db")
    t.write(f"Users/{t.me}/Library/Group Containers/TEAM123456.shared/x")
    t.write(f"Users/{t.me}/Library/Preferences/Scan Settings.plist")          # a name alone: never matched
    t.write(f"Users/{t.me}/Library/Preferences/com.example.Event-ManagerX.plist")   # no dot after the id
    t.plist("Library/LaunchAgents/com.example.agent.plist",
            {"Label": "com.example.agent", "ProgramArguments": [shown(a / "Contents/MacOS/Event Manager"), "-x"]})
    t.write("Library/Application Support/EXAMPLE/scanner.bin")
    t.write("Library/Extensions/ExampleRAID.kext/Contents/Info.plist", "x")
    t.receipt("com.example.pkg.scanner", "/", ["Library", "Library/Application Support/EXAMPLE",
                                                   "Library/Application Support/EXAMPLE/scanner.bin",
                                                   "Library/Extensions/ExampleRAID.kext",
                                                   "Library/Extensions/ExampleRAID.kext/Contents",
                                                   "Library/Extensions/ExampleRAID.kext/Contents/Info.plist",
                                                   "Applications/Example Software/Event Manager.app"])
    t.answer("launchctl", f"print gui/{t.uid}/com.example.agent", "\tstate = running\n\tpid = 4242\n")
    t.answer("launchctl", f"bootout gui/{t.uid}/com.example.agent", "")
    t.answer("ps", "-axo pid=,comm=", f"  1 /sbin/launchd\n4242 {shown(a)}/Contents/MacOS/Event Manager\n")
    return t.path("Applications/Example Software")


def t_show_finds_everything(t: T) -> None:
    folder = epson(t)
    rc, out, e = t.run(["show", str(folder)])
    t.check(rc == 0, f"rc {rc}: {e}")
    for want in ("2 app(s), 1 item(s), team id TEAM123456, 1 receipt(s)",
                 "Event Manager.app", "[in the folder]",
                 "com.example.agent.plist", "[program in item; running]",
                 f"~{t.me}/Library/Preferences/com.example.Event-Manager.plist", "~other/Library/Preferences",
                 f"~{t.me}/Library/Caches/com.example.Manuals", "TEAM123456.shared", "[team id TEAM123456]",
                 "/Library/Application Support/EXAMPLE", "/Library/Extensions/ExampleRAID.kext",
                 "[receipt com.example.pkg.scanner]", "all their files covered above"):
        t.check(want in out, f"show prints {want!r}:\n{out}")
    for never in ("Scan Settings", "Event-ManagerX"):
        t.check(never not in out, f"{never} is not matched (a name alone, no dot after the id)")
