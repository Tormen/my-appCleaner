def t_rm_go_moves_to_trash(t: T) -> None:
    global _geteuid, _kill
    folder = epson(t)
    killed: List[Tuple[int, int]] = []

    def kill(pid: int, sig: int) -> None:
        killed.append((pid, sig))
        if sig == 0:
            raise ProcessLookupError()

    _geteuid, _kill = (lambda: 0), kill
    rc, _, e = t.run(["rm", str(folder), "go"])
    t.check(rc == 0, f"rc {rc}: {e}")
    calls = t.calls()
    t.check(f"launchctl bootout gui/{t.uid}/com.example.agent" in calls, f"the agent is booted out: {calls}")
    t.check((4242, signal.SIGTERM) in killed, f"the running app is ended: {killed}")
    t.check("pkgutil --forget com.example.pkg.scanner" in calls, "the receipt is forgotten")
    for gone in ("Applications/Example Software", "Library/LaunchAgents/com.example.agent.plist",
                 "Library/Application Support/EXAMPLE", "Library/Extensions/ExampleRAID.kext",
                 f"Users/{t.me}/Library/Preferences/com.example.Event-Manager.plist",
                 "Users/other/Library/Preferences/com.example.Event-Manager.plist"):
        t.check(not t.path(gone).exists(), f"{gone} is gone from its place")
    t.check(t.trashed("Example Software") and t.trashed("com.example.Event-Manager.plist")
            and t.trashed("ExampleRAID.kext"), "everything is in the owner's Trash")
    t.check(t.path(f"Users/{t.me}/Library/Preferences/Scan Settings.plist").exists(), "an unmatched file stays")
    log = (t.dir / "log" / "moves.log").read_text(encoding="utf-8")
    t.check("\ttrashed\t/Applications/Example Software\t" in log, f"LOG names each move: {log}")
    t.check(" >>> done: " in e and " removed [rc 0]" in e, f"the summary: {e}")


