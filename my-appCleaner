    _arguments '-Q[quiet]' '-V[verbose]' '-D[debug]' '--config[config file]:file:_files' \\
      '--create-config[the default config]' '--run-tests[the built-in tests]' '--version[the exact build]' \\
      '*:app:_files'
    return
  fi
  case $words[2] in
    show) _files ;;
    rm) _alternative 'go:go:(go)' 'app:app:_files' ;;
    intel) _files -/ ;;
  esac
}}
