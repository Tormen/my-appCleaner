def t_config_search_and_offer(t: T) -> None:
    global _site_conf
    farm, offer = t.dir / "farm", t.dir / "offer"
    farm.mkdir()
    _site_conf = t.dir / "site.conf"
    _site_conf.write_text(f'CONFIG_SEARCH_DIR="{farm}"\nCONFIG_OFFER_DIR="{offer}"\n'
                          f'CONFIG_OFFER_NOTE="linked into the farm"\nLOG_BASE_DIR="{t.dir}/logs"\n', encoding="utf-8")
    old = os.environ.pop("MY_APPCLEANER_CONFIG", None)
    home = os.environ.get("HOME", "")
    os.environ["HOME"] = str(t.dir)
    out, errs = io.StringIO(), io.StringIO()
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(errs):
            rc = main(["intel", str(t.path("usr/local"))])
        t.check(rc == 1 and f"--create-config > {offer}/{SCRIPT_NAME}.conf   (linked into the farm)" in errs.getvalue()
                and str(farm) + "/" not in errs.getvalue(), f"no config: the site's offer first, never the farm: {errs.getvalue()}")
        (farm / f"{SCRIPT_NAME}.GLOBAL").write_text(t.config().read_text(encoding="utf-8"), encoding="utf-8")
        (farm / SCRIPT_NAME).write_text('VRB="1"\n', encoding="utf-8")
        out, errs = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(errs):
            rc = main(["intel", str(t.path("usr/local"))])
        OUT.__init__()
        t.check(rc == 0, f"the bare name in the farm, its .GLOBAL first: rc {rc}: {errs.getvalue()}")
    finally:
        os.environ["HOME"] = home
        if old is not None:
            os.environ["MY_APPCLEANER_CONFIG"] = old


def t_site_conf_cannot_tell(t: T) -> None:
